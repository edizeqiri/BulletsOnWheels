[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.3
reloadable = true

[libraries]
linux.debug.x86_64 = "res://../rust/target/debug/libbullets_on_wheels.so"
linux.release.x86_64 = "res://../rust/target/release/libbullets_on_wheels.so"
windows.debug.x86_64 = "res://../rust/target/debug/bullets_on_wheels.dll"
windows.release.x86_64 = "res://../rust/target/release/bullets_on_wheels.dll"
macos.debug = "res://../rust/target/debug/libbullets_on_wheels.dylib"
macos.release = "res://../rust/target/release/libbullets_on_wheels.dylib"
macos.debug.arm64 = "res://../rust/target/debug/libbullets_on_wheels.dylib"
macos.release.arm64 = "res://../rust/target/release/libbullets_on_wheels.dylib"
